{
  "nav": {
    "label": "Hand Raise",
    "icon": "raise-hand-regular",
    "iconType": "momentumDesign",
    "navigateTo": "hand-raise-page",
    "align": "top",
    "isDefaultLandingPage": false
  },
  "page": {
    "id": "hand-raise-page",
    "widgets": {
      "hand-raise-area": {
        "comp": "hand-raise-supervisor",
        "script": "https://kadammmmm.github.io/hand-raise-widget/supervisor.js",
        "attributes": {
          "darkmode": "$STORE.app.darkMode"
        },
        "properties": {
          "backendUrl": "https://hand-raise-api.onrender.com/api",
          "accessToken": "$STORE.auth.accessToken",
          "slaThresholdSeconds": 90
        }
      }
    },
    "layout": {
      "areas": [["hand-raise-area"]],
      "size": { "cols": [1], "rows": [1] }
    }
  }
}
